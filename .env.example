# Copia este archivo a .env y llena los valores. .env NO se sube al repo.

# Llave Fernet para cifrar el mensaje original en el audit log. OBLIGATORIA.
# Genera una con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AUDIT_ENCRYPTION_KEY=

# Ruta del audit log (JSON Lines). Default: data/audit_log.jsonl
AUDIT_LOG_PATH=

# Que hacer si la red 2 detecta posible PII no reconocida:
#   redact (default) -> la tapa con <REDACTED: SUSPECTED_PII> y sigue
#   block            -> responde 422 y NO llama al LLM
RESIDUAL_PII_MODE=

# Probabilidad de fallo del mock de IA (0.0 - 1.0). Default: 0
# Pon 1 para ver el circuit breaker abrirse.
MOCK_AI_FAILURE_RATE=
